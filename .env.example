# Copy to .env and fill in. NEVER commit .env.
# With no key set, the API still works: explanations come from the
# built-in fill-in-the-blank template instead of Gemini.

# --- LLM explanation: Gemini -> local Ollama -> template -------------
# Google AI Studio key (Gemini free tier). Empty = skip straight to Ollama.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Hard budget for one explanation call; the next layer takes over after this.
LLM_TIMEOUT_SECONDS=3.5
# Set to false to force the template even when a provider is reachable.
LLM_ENABLED=true

# --- Local Ollama (no key, data stays on the machine) ---------------
# Pull a model first: `ollama pull qwen2.5:3b-instruct`
# Point OLLAMA_MODEL at the fine-tuned tag once the LoRA adapter is GGUF.
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
OLLAMA_TIMEOUT_SECONDS=8.0

# --- Caching --------------------------------------------------------
# Explanations are computed once per ring and reused for this long,
# so refreshing the dashboard never re-calls the LLM.
CACHE_TTL_SECONDS=600
# How long Person 1's detection result is reused before re-running.
DETECTION_CACHE_TTL_SECONDS=60

# --- Person 1 detection hook ---------------------------------------
# /alerts calls <DETECTION_MODULE>.<DETECTION_FUNCTION>() when it exists.
DETECTION_MODULE=detection
DETECTION_FUNCTION=find_rings
# Artifacts written by training/train_detector.py on the full PaySim CSV.
DETECTED_RINGS_PATH=data/detected_rings.json
DETECTOR_METRICS_PATH=data/model/metrics.json
# If detection returns 0 rings, serve the built-in fake alerts instead
# (set true to protect the live demo).
FALLBACK_TO_FAKE_WHEN_EMPTY=false

# --- Person 4 fake alerts (used while detection doesn't exist) ------
FAKE_ALERTS_PATH=data/fake_alerts.json

# --- Frontend -------------------------------------------------------
# Comma-separated origins allowed to call the API, or * for any.
CORS_ORIGINS=*
